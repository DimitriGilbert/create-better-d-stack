#!/usr/bin/env node
import { Command } from "commander";

import { healthCommand } from "./commands/health";

const program = new Command();

program
  .name("{{projectName}}")
  .description("Command-line interface for {{projectName}}")
  .version("0.0.0");

program.addCommand(healthCommand);

program
  .command("info")
  .description("Print information about this project")
  .action(() => {
    const stack: Record<string, string> = {
      frontend: "{{frontend}}",
      backend: "{{backend}}",
      database: "{{database}}",
      orm: "{{orm}}",
      api: "{{api}}",
      auth: "{{auth}}",
      runtime: "{{runtime}}",
      packageManager: "{{packageManager}}",
    };
    for (const [key, value] of Object.entries(stack)) {
      console.log(`${key.padEnd(14)} ${value}`);
    }
  });

// Bare invocation prints help and exits 0, so workspace `dev` aggregates
// (turbo run dev / -r dev / --filter '*' dev) don't abort on this package.
program.action(() => {
  program.outputHelp();
});

program.parse();
